<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime compatible. No private injection entitlements.
	     Deliberately omit: allow-dyld-environment-variables, disable-library-validation,
	     get-task-allow (release), any Dock/automation private keys. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
